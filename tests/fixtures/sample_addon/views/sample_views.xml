<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OR074: this id is defined twice in the same addon -->
    <record id="view_sample_form" model="ir.ui.view">
        <field name="name">sample.form</field>
        <field name="model">sample.model</field>
        <field name="arch" type="xml">
            <form>
                <!-- OR073: t-raw renders unescaped HTML (XSS risk) -->
                <span t-raw="record.description"/>
            </form>
        </field>
    </record>

    <record id="view_sample_form" model="ir.ui.view">
        <field name="name">sample.form.dup</field>
        <field name="model">sample.model</field>
    </record>

    <!-- OR075: act_window with no res_model -->
    <record id="action_sample" model="ir.actions.act_window">
        <field name="name">Samples</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
